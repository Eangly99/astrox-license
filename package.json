{
  "name": "cipher-bot",
  "version": "1.0.0",
  "description": "Production-grade Discord bot for Minecraft plugin license management",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/bot/deploy-commands.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@keyv/redis": "^5.1.6",
    "discord.js": "^14.26.4",
    "dotenv-flow": "^4.1.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "keyv": "^5.0.0",
    "mongoose": "^8.24.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.0.0",
    "mermaid": "^11.15.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.0",
    "vite": "^8.1.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "discord",
    "license",
    "minecraft",
    "spigot",
    "paper"
  ],
  "license": "UNLICENSED",
  "private": true
}
