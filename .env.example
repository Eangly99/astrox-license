# ──────────────────────────────────────────────
# AstroX License — Environment Configuration
# ──────────────────────────────────────────────

# Discord Bot Token (from Developer Portal)
BOT_TOKEN=

# Discord Application / Client ID
CLIENT_ID=

# Discord Server (Guild) ID for command deployment
GUILD_ID=

# Role ID allowed to run /admin commands
ADMIN_ROLE_ID=

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/astrox-license

# Redis connection string (optional — falls back to in-memory LRU)
REDIS_URI=

# 256-bit secret for HMAC license signing (min 32 characters)
HMAC_SECRET=

# Fastify API listen port
API_PORT=3000

# Environment: development | production
NODE_ENV=production
